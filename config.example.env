# Example settings for wms-go. Copy to /etc/wms-go/wms-go.env (used by the systemd units) and edit.
# Secrets (API keys, tokens) are better entered in the TUI (Admin > Settings & API Keys): they are stored mode 0600.

# --- where things are ---
# PARTDB_DB_PATH=/path/to/partdb/db/app.db
# MODERNWMS_CONTAINER=modernwms
# PARTDB_URL=https://partdb.example.com/          # used to build links; omitted when empty
# MODERNWMS_URL=https://modernwms.example.com/
# LEGO_DB_PATH=/var/lib/wms-go/lego.db
# AUDIT_LOG_FILE=/var/log/wms-go/audit.log

# --- behaviour ---
# TUI_IDLE_LOCK_MINUTES=15        # 0 = never lock an idle session
# CATALOG_AUTO_REFRESH_HOURS=24   # keep the offline catalog current from the gateway (0 = off; at most daily)
# MODERNWMS_TUI_THEME=green       # green, amber, high-contrast, colorblind (NO_COLOR=1 turns colour off)
# MODERNWMS_TUI_IMAGES=auto       # auto, blocks, ascii, off
# WMS_EQUIVALENTS=default         # default (alternates+moulds), none, or alt,mold,print
# BRICKLINK_CURRENCY=GBP
# BRICKLINK_REGION=europe

# --- alerts (off unless set) ---
# NOTIFY_URL=https://ntfy.sh/your-secret-topic

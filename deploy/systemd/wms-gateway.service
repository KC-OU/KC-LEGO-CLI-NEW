[Unit]
Description=wms-go telnet + web terminal gateway
After=network.target docker.service

[Service]
Type=simple
ExecStart=/usr/local/bin/wms-go gateway serve
# Optional settings (NOTIFY_URL, TUI_IDLE_LOCK_MINUTES, ...): one KEY=value per line.
EnvironmentFile=-/etc/wms-go/wms-go.env
Restart=always
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target
